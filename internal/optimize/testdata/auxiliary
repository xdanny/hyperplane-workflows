#!/usr/bin/env python3
"""Deterministic model transport for private auxiliary-workspace tests."""
import json, os, pathlib, stat, sys, time
args=sys.argv[1:]
assert '--ignore-user-config' in args and '--ignore-rules' in args
assert args[args.index('--sandbox')+1]=='read-only'
workspace=pathlib.Path(args[args.index('--cd')+1])
assert stat.S_IMODE(workspace.stat().st_mode)==0o700
prompt=sys.stdin.read()
with open(os.environ['SDK_AUXILIARY_CALLS'],'a') as f:
    f.write(json.dumps({'workspace':str(workspace),'prompt':prompt})+'\n')
print(json.dumps({'type':'thread.started','thread_id':'auxiliary-fixture'}),flush=True)
if os.environ.get('SDK_AUXILIARY_MODE')=='hang':
    time.sleep(60)
if os.environ.get('SDK_AUXILIARY_MODE')=='fail':
    print(json.dumps({'type':'turn.failed','error':{'message':'controlled auxiliary failure'}}),flush=True)
    sys.exit(0)
time.sleep(.05)
print(json.dumps({'type':'item.completed','item':{'id':'reply','type':'agent_message','text':'["fixture proposal"]'}}),flush=True)
print(json.dumps({'type':'turn.completed','usage':{'input_tokens':1,'cached_input_tokens':0,'output_tokens':1}}),flush=True)
