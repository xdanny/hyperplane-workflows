#!/usr/bin/env python3
"""Fixture responses only; exercises actual SDK options, thread handoff and host IO."""
import json, os, pathlib, re, sys, time
args = sys.argv[1:]
assert args[0] == 'exec' and '--ignore-user-config' in args and '--ignore-rules' in args
assert args[args.index('--sandbox') + 1] == 'read-only'
for setting in ['features.plugins=false', 'features.apps=false', 'features.hooks=false', 'features.memories=false', 'features.multi_agent=false']:
    assert setting in args, setting
workspace = pathlib.Path(args[args.index('--cd') + 1])
prompt = sys.stdin.read()
review = '--output-schema' in args
stage = 'review' if review else ['sources', 'research', 'concepts', 'review', 'after'][int(re.search(r'Step (\d+) of', prompt).group(1))-1]
web = 'web_search="live"' in args
assert web == (stage in ['sources', 'review'])
assert 'sandbox_workspace_write.network_access=true' not in args
thread = 'fixture-review' if review else 'fixture-sources' if stage == 'sources' else 'fixture-research'
if stage not in ['sources', 'research', 'review']:
    assert 'resume' in args and args[args.index('resume')+1] == thread
    assert (workspace/'sources.md').is_file()
else:
    assert 'resume' not in args
if stage == 'research':
    assert (workspace/'sources.md').is_file()
if review:
    assert (workspace/'concepts.md').is_file()
    assert 'Criteria:' in prompt and 'research.md' in prompt
with open(os.environ['SDK_FIXTURE_CALLS'], 'a') as f:
    f.write(json.dumps({'stage': stage, 'thread': thread, 'web': web})+'\n')
print(json.dumps({'type':'thread.started','thread_id':thread}),flush=True)
mode = os.environ.get('SDK_FIXTURE_MODE','ordinary')
if review and mode == 'hang': time.sleep(300)
if web and not (mode == 'no-search' or (review and mode == 'review-no-search')):
    print(json.dumps({'type':'item.completed','item':{'id':'source','type':'web_search','query':'fixture sources'}}))
text = '# '+stage+'\nFixture evidence at https://example.com/evidence. These are fixture responses.'
if review:
    text = '{}' if mode == 'invalid' else json.dumps({'passed':mode != 'reject', 'findings':['Fixture caveat retained'] if mode == 'ordinary' else ['Fixture evidence is insufficient'], 'restatement':'The fixture research was reviewed; inspect its evidence.'})
print(json.dumps({'type':'item.completed','item':{'id':'answer','type':'agent_message','text':text}}))
print(json.dumps({'type':'turn.completed','usage':{'input_tokens':17,'cached_input_tokens':3,'output_tokens':2}}))
