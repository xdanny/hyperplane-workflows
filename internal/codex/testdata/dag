#!/usr/bin/env python3
"""Only model output is simulated; SDK concurrency and PostgreSQL are real."""
import json
import os
import pathlib
import re
import sys
import time

args = sys.argv[1:]
assert args[0] == 'exec' and '--ignore-user-config' in args and '--ignore-rules' in args
assert 'resume' not in args, 'DAG nodes must not share a conversation'
assert args[args.index('--sandbox') + 1] == 'read-only'
prompt = sys.stdin.read()
node = re.search(r'DAG_NODE:([a-z]+)', prompt).group(1)
root = pathlib.Path(os.environ['SDK_FIXTURE_DAG_DIR'])
(root / (node + '.started')).write_text(str(os.getpid()))
print(json.dumps({'type': 'thread.started', 'thread_id': 'fixture-dag-' + node}), flush=True)
if node in ('left', 'right'):
    deadline = time.monotonic() + 15
    while not (root / 'release').exists():
        assert time.monotonic() < deadline, 'Both independent branches must start before release'
        time.sleep(0.02)
if os.environ.get('SDK_FIXTURE_MODE') == 'fail':
    if node == 'left':
        sys.exit(9)
    if node == 'right':
        time.sleep(30)
if node == 'join':
    assert (root / 'left.finished').exists() and (root / 'right.finished').exists()
(root / (node + '.finished')).write_text('done')
print(json.dumps({'type': 'item.completed', 'item': {'id': 'answer', 'type': 'agent_message', 'text': '# ' + node + '\nFixture document for ' + node + '.'}}), flush=True)
print(json.dumps({'type': 'turn.completed', 'usage': {'input_tokens': 17, 'cached_input_tokens': 3, 'output_tokens': 2}}), flush=True)
