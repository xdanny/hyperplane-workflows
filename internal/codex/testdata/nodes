#!/usr/bin/env python3
"""Fixture model only: actual Codex SDK transport, host files and DB checkpoints."""
import json
import os
import pathlib
import sys
import time

args = sys.argv[1:]
assert args[0] == 'exec' and '--ignore-user-config' in args and '--ignore-rules' in args
assert args[args.index('--sandbox') + 1] == 'read-only'
workspace = pathlib.Path(args[args.index('--cd') + 1])
prompt = sys.stdin.read()
resumed = 'resume' in args
continuing = os.environ.get('SDK_FIXTURE_CONTINUATION') == '1'
if continuing:
    assert not resumed, 'Continuation must start a fresh conversation'
    assert ('Step 3 of 3: Review' if os.environ.get('SDK_FIXTURE_APPROVAL') == '1' else 'Step 2 of 2: Review') in prompt
    assert (workspace / 'explore.md').read_text().startswith('# Explore')
    if os.environ.get('SDK_FIXTURE_APPROVAL') == '1':
        assert 'Human decision: approved.' in (workspace / 'approval.md').read_text()
elif resumed:
    assert args[args.index('resume') + 1] == 'fixture-nodes-thread'
    assert (workspace / 'explore.md').read_text().startswith('# Explore')
    assert 'explore.md' in prompt
    if os.environ.get('SDK_FIXTURE_APPROVAL') == '1':
        assert 'Human decision: approved.' in (workspace / 'approval.md').read_text()
else:
    assert ('Step 1 of 3: Explore' if os.environ.get('SDK_FIXTURE_APPROVAL') == '1' else 'Step 1 of 2: Explore') in prompt
calls = os.environ.get('SDK_FIXTURE_CALLS')
if calls:
    with open(calls, 'a') as file:
        file.write('review\n' if resumed or continuing else 'explore\n')
# Delay publication after the external call ledger to exercise cancellation races.
if resumed and os.environ.get('SDK_FIXTURE_DELAY_STARTED') == '1':
    time.sleep(0.15)
print(json.dumps({'type': 'thread.started', 'thread_id': 'fixture-nodes-thread'}), flush=True)
mode = os.environ.get('SDK_FIXTURE_MODE', 'ordinary')
if mode == 'hang' and resumed:
    time.sleep(300)
if mode == 'transport' and resumed:
    sys.exit(7)
text = '# Review\nChoose option A from explore.md. This is fixture content.' if resumed or continuing else '# Explore\nOptions A and B. This is fixture content.'
print(json.dumps({'type': 'item.completed', 'item': {'id': 'answer', 'type': 'agent_message', 'text': text}}))
print(json.dumps({'type': 'turn.completed', 'usage': {'input_tokens': 17, 'cached_input_tokens': 3, 'output_tokens': 2}}))
