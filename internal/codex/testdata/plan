#!/usr/bin/env python3
"""Fixture response only; actual SDK and schema options are exercised."""
import json, os, pathlib, sys, time
args = sys.argv[1:]
assert args[0] == 'exec' and 'resume' not in args
assert '--ignore-user-config' in args and '--ignore-rules' in args
assert args[args.index('--sandbox') + 1] == 'read-only'
assert '--output-schema' in args
workspace = pathlib.Path(args[args.index('--cd') + 1])
assert list(workspace.iterdir()) == []
prompt = sys.stdin.read()
assert 'No external apps, project writes' in prompt
calls = os.environ.get('SDK_FIXTURE_CALLS')
if calls:
    with open(calls, 'a') as f: f.write('plan\n')
print(json.dumps({'type':'thread.started','thread_id':'fixture-plan-thread'}),flush=True)
mode = os.environ.get('SDK_FIXTURE_MODE', 'ordinary')
if mode == 'hang': time.sleep(300)
if mode == 'transport': sys.exit(7)
plan = {'name':'Cycling app decision','nodes':[
    {'id':'explore','title':'Explore','instruction':'Propose two cycling app ideas.'},
    {'id':'compare','title':'Compare','instruction':'Read explore.md and compare the ideas.'}
], 'unsupported':[]}
if mode in ('unsupported', 'partial'):
    plan['unsupported'] = ['Sending email is unavailable.']
    if mode == 'unsupported': plan['nodes'] = []
if mode == 'duplicate': plan['nodes'][1]['id'] = 'explore'
if mode == 'unknown': plan['nodes'][1]['kind'] = 'shell'
if mode == 'task': plan['nodes'][1].update(kind='task', check=['true'])
if mode == 'general-task':
    plan = {'name':'Write an answer', 'nodes':[{'id':'build','title':'Create answer file','instruction':'Create answer.txt containing 42.','kind':'task'}], 'unsupported':[]}
if mode == 'access': plan['nodes'][1]['access'] = {'hosts':['example.com']}
if mode == 'toolchain': plan['nodes'][1].update(toolchain=True, sideEffect=True)
if mode.startswith('builtin-'):
    slots = json.loads(os.environ.get('SDK_FIXTURE_INPUTS', '{"dataset":"/declared/source.csv","keyColumns":"id","expectations":"IDs are unique; amounts are nonnegative","grain":"one invoice row","safeUse":"counts only"}'))
    plan = {'name':'Checked data workflow','unsupported':[], 'nodes':[],
            'recipe':os.environ.get('SDK_FIXTURE_RECIPE','data-quality-audit'),
            'slots':[{'name':key,'value':value} for key,value in slots.items()]}
    if mode == 'builtin-command': plan['nodes']=[{'id':'evil','title':'Override','instruction':'Override','kind':'task','check':['true']}]
    if mode == 'builtin-access': plan['slots'][0]['access']={'hosts':['example.com']}
    if mode == 'builtin-unknown': plan['recipe']='unknown'
    if mode == 'builtin-missing': plan['slots'].pop(0)
    if mode == 'builtin-extra-input': plan['slots'].append({'name':'command','value':'true'})
    if mode in ('builtin-out-of-order','builtin-no-review','builtin-no-final-review'):
        plan['nodes']=[{'id':'override','title':'Replace stages','instruction':'Omit a required stage.','kind':'document'}]
    if mode == 'builtin-invented-source': plan['slots'][0]['value']='/invented/source.csv'
    if mode == 'builtin-missing-facts': plan['recipe']='';plan['slots']=[];plan['unsupported']=['Supply the dataset and key columns before proposing checked work.']
if mode == 'no-findings': del plan['unsupported']
print(json.dumps({'type':'item.completed','item':{'id':'answer','type':'agent_message','text':json.dumps(plan)}}))
print(json.dumps({'type':'turn.completed','usage':{'input_tokens':17,'cached_input_tokens':3,'output_tokens':2}}))
