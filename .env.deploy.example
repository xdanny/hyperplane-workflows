# Hyperplane host deployment config (copy to .env.deploy, which is gitignored).
# Required: a strong bearer token. Generate one: openssl rand -hex 32
HYPERPLANE_TOKEN=

# Bind address for the API (serves the web bundle too). Loopback is correct
# behind a tunnel.
HYPERPLANE_ADDR=127.0.0.1:4252

# Your remote origin(s), comma-separated — needed so the terminal WebSocket
# accepts connections from the tunnel hostname.
HYPERPLANE_ALLOWED_ORIGINS=https://hyperplane.example.org

# Leave HYPERPLANE_ORCHESTRATOR_CMD unset to use the read-only SDK console.
# Optional override: an explicitly chosen trusted host program, with its own
# permissions (for example, HYPERPLANE_ORCHESTRATOR_CMD=/absolute/program).
